{
  "builds": [
    { "src": "backend/app.js", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/app.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "env": {
    "COOKIE_SECURE": "true"
  }
}

